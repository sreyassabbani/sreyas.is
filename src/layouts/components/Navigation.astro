---
import { getCollection } from "astro:content";
import ThemeToggle from "../../components/ThemeToggle.astro";
import GitHub from "../../components/social/GitHub.astro";
import LinkedIn from "../../components/social/LinkedIn.astro";
import Email from "../../components/social/Email.astro";
import { NavigationDropdown } from "./NavigationDropdown";
import { ThinkingFilterControl } from "../../components/ThinkingFilterControl";
import { ThinkingFilterClauses } from "../../components/ThinkingFilterClauses";
import { createNavigationGroups, type NavigationItem } from "@/lib/navigation";
import {
    formatTag,
    getDateSlug,
    getTagHref,
    getThinkingTopics,
    groupEntriesByDate,
} from "@/lib/thinking";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const contentPageItems: NavigationItem[] = (await getCollection("pages"))
    .map((page) => ({
        href: `/${page.id}`,
        label: page.data.title,
    }))
    .sort((left, right) => left.label.localeCompare(right.label));
const navigationGroups = createNavigationGroups(contentPageItems);
const isThinking = /^\/thinking(?:\/|$)/.test(pathname);
const thinkingEntries = isThinking ? await getCollection("posts") : [];
const dates = groupEntriesByDate(thinkingEntries).map(
    (group) => group.dateSlug,
);
const topics = getThinkingTopics(thinkingEntries).map((topic) => ({
    href: getTagHref(topic.tag),
    label: formatTag(topic.tag),
    count: topic.entries.length,
    dates: topic.entries.map((entry) => getDateSlug(entry.data.pubDate)),
}));

const controlsClass =
    "absolute bottom-0 left-full z-10 flex shrink-0 -translate-x-1/2 translate-y-1/2 items-center gap-2";
const socialLinksClass = "flex items-center gap-1 md:gap-4 md:px-3";
---

<nav
    style="view-transition-name: site-nav"
    class:list={[
        "relative flex flex-col gap-3 border-b border-border py-3 text-sm text-foreground has-[[data-slot=thinking-clause]]:pb-6 md:min-h-14 md:flex-row md:items-center md:justify-between md:gap-0 md:px-2 md:py-2 md:has-[[data-slot=thinking-clause]]:pb-6",
        isHome ? "w-full" : "w-[calc(100%-5.5rem)]",
    ]}
>
    <div class="@container/nav min-w-0 md:w-full">
        <div
            data-navigation-grid
            class="grid min-w-0 grid-cols-[auto_minmax(0,1fr)] items-center gap-x-2 gap-y-3 md:gap-x-3 data-[filters-inline=true]:grid-cols-[auto_auto_minmax(0,1fr)]"
        >
            <NavigationDropdown
                pathname={pathname}
                groups={navigationGroups}
                client:load
            />
            {
                isThinking && (
                    <ThinkingFilterClauses
                        pathname={pathname}
                        topics={topics}
                        dates={dates}
                        client:load
                    />
                )
            }
        </div>
    </div>

    <div class={controlsClass}>
        <ThemeToggle />
        <ThinkingFilterControl pathname={pathname} client:load />
    </div>

    <div
        class="flex items-center justify-between gap-4 md:w-auto md:min-w-0 md:justify-end md:gap-4 lg:gap-6"
    >
        {
            isHome && (
                <div class={socialLinksClass}>
                    <GitHub />
                    <LinkedIn />
                    <Email />
                </div>
            )
        }
    </div>
</nav>
