---
import ThemeToggle from "../../components/ThemeToggle.astro";
import GitHub from "../../components/social/GitHub.astro";
import LinkedIn from "../../components/social/LinkedIn.astro";
import Email from "../../components/social/Email.astro";
import { NavigationDropdown } from "./NavigationDropdown";
import { ThinkingFilterControl } from "../../components/ThinkingFilterControl";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";

const controlsClass =
    "flex shrink-0 items-center gap-2 md:absolute md:-right-4 md:bottom-0 md:z-10 md:translate-y-1/2";
const socialLinksClass = "flex items-center gap-1 md:gap-4 md:px-3";
---

<nav
    class="relative flex w-full flex-col gap-3 border-b border-border py-3 text-sm text-foreground md:h-14 md:flex-row md:items-center md:justify-between md:gap-0 md:px-2 md:py-0"
>
    <div
        class="flex items-center justify-between gap-3 md:w-full md:min-w-0 md:justify-start"
    >
        <NavigationDropdown pathname={pathname} client:only="react" />
        <div class={controlsClass}>
            <ThemeToggle />
            <ThinkingFilterControl pathname={pathname} client:only="react" />
        </div>
    </div>

    <div
        class="flex items-center justify-between gap-4 md:w-auto md:min-w-0 md:justify-end md:gap-4 lg:gap-6"
    >
        {
            isHome && (
                <div class={socialLinksClass}>
                    <GitHub />
                    <LinkedIn />
                    <Email />
                </div>
            )
        }
    </div>
</nav>
