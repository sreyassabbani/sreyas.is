---
import { Image } from "astro:assets";
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import BaseHead from "@/components/BaseHead.astro";
import ContentPostInlineToc from "@/components/ContentPostInlineToc.astro";
import ContentPostRail from "@/components/ContentPostRail.astro";
import CopyCodeButton from "@/components/CopyCodeButton.astro";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { contentProseClass } from "@/lib/content-prose";
import { getInlineTocGroups, getRailTocGroups } from "@/lib/content-toc";
import { getTagHref } from "@/lib/thinking";

type Props = CollectionEntry<"posts">["data"] & {
    headings: MarkdownHeading[];
};

const {
    title,
    description,
    pubDate,
    updatedDate,
    heroImage,
    tags,
    toc,
    headings,
} = Astro.props as Props;

const showToc = toc !== false;
const inlineTocGroups = showToc ? getInlineTocGroups(headings) : [];
const railTocGroups = showToc ? getRailTocGroups(headings) : [];

const articleContainerClass = "mx-auto w-full max-w-3xl";
---

<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
    </head>

    <body
        id="top"
        class="min-h-screen overflow-x-hidden bg-background text-foreground"
    >
        {showToc && <ContentPostRail groups={railTocGroups} />}

        <div
            class="mx-auto w-full max-w-4xl px-4 pb-14 pt-4 sm:px-6 sm:pb-16 sm:pt-6"
        >
            <main class={articleContainerClass}>
                <a
                    href="/thinking"
                    class="inline-flex items-center rounded-full text-sm text-muted-foreground no-underline transition-colors duration-200 hover:text-foreground"
                >
                    Back
                </a>

                <article class="mt-6">
                    {
                        heroImage && (
                            <figure class="mb-6 overflow-hidden rounded-2xl border border-border bg-card">
                                <Image
                                    width={1020}
                                    height={510}
                                    src={heroImage}
                                    alt=""
                                />
                            </figure>
                        )
                    }

                    <header class="mb-10 text-left sm:mb-12 sm:text-center">
                        <p class="m-0 text-sm text-muted-foreground">
                            <FormattedDate date={pubDate} />
                        </p>
                        {
                            updatedDate && (
                                <p class="mt-1 text-xs text-muted-foreground">
                                    Updated <FormattedDate date={updatedDate} />
                                </p>
                            )
                        }
                        <h1
                            class="mt-4 text-balance font-heading text-3xl font-semibold leading-tight tracking-tight sm:text-4xl md:text-5xl"
                        >
                            {title}
                        </h1>
                        {
                            description && (
                                <p class="mt-4 max-w-2xl text-pretty text-[0.98rem] leading-7 text-muted-foreground sm:mx-auto sm:text-base sm:leading-8">
                                    {description}
                                </p>
                            )
                        }
                        <div
                            class="mt-5 h-px w-32 bg-border sm:mx-auto sm:w-40"
                        >
                        </div>
                        {
                            tags.length > 0 && (
                                <nav
                                    class="mt-5 flex flex-wrap gap-2 sm:justify-center"
                                    aria-label="Topics"
                                >
                                    {tags.map((tag) => (
                                        <a
                                            href={getTagHref(tag)}
                                            class="rounded-full border border-border px-3 py-1 font-mono text-[0.7rem] text-muted-foreground no-underline transition-colors duration-200 hover:border-primary/40 hover:text-primary"
                                        >
                                            {tag}
                                        </a>
                                    ))}
                                </nav>
                            )
                        }
                    </header>

                    {
                        showToc && (
                            <ContentPostInlineToc groups={inlineTocGroups} />
                        )
                    }

                    <div class={contentProseClass}>
                        <slot />
                    </div>
                </article>
            </main>

            <div
                class={`${articleContainerClass} mt-[4.5rem] border-t border-border pt-6 text-center text-xs text-muted-foreground sm:mt-24`}
            >
                <Footer />
            </div>
        </div>

        <CopyCodeButton />
    </body>
</html>
