---
import { getCollection } from "astro:content";
import { groupEntriesByDate } from "@/lib/thinking";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";
import ThinkingEntryList from "@/components/ThinkingEntryList.astro";
import Layout from "@/layouts/Layout.astro";

const entries = await getCollection("posts");
const dateGroups = groupEntriesByDate(entries);
---

<Layout title={`${SITE_TITLE} — Thinking`} description={SITE_DESCRIPTION}>
    <section class="space-y-8 sm:space-y-9">
        <div class="space-y-6 mt-8">
            <ThinkingEntryList groups={dateGroups} />
        </div>
    </section>
</Layout>
