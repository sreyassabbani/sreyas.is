---
import { getCollection } from "astro:content";
import {
    formatTag,
    getAllTags,
    getDateSlug,
    getEntriesForTag,
    getThinkingHref,
} from "@/lib/thinking";
import { SITE_TITLE } from "@/consts";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
    const entries = await getCollection("posts");
    return getAllTags(entries).map((tag) => ({
        params: { tag },
        props: {
            tag,
            entries: getEntriesForTag(entries, tag),
        },
    }));
}

const { tag, entries } = Astro.props;
---

<Layout
    title={`${SITE_TITLE} — Thinking about ${formatTag(tag)}`}
    description={`Posts and notes about ${formatTag(tag).toLowerCase()}.`}
    showNavigation={false}
>
    <section class="space-y-8">
        <header class="space-y-4 border-b border-border pb-6">
            <a
                href="/thinking/about"
                class="text-link font-mono text-sm text-muted-foreground"
            >
                /thinking/about
            </a>
            <h1
                class="text-balance font-heading text-3xl font-semibold tracking-tight text-foreground"
            >
                {formatTag(tag).toLowerCase()}
            </h1>
        </header>

        <div class="space-y-5">
            {
                entries.map((entry) => (
                    <article class="grid gap-2 border-b border-border pb-5 last:border-0 sm:grid-cols-[7.5rem_1fr]">
                        <div class="space-y-1 font-mono text-xs text-muted-foreground">
                            <a
                                href={`/thinking/on/${getDateSlug(entry.data.pubDate)}/`}
                                class="text-link text-muted-foreground"
                            >
                                {getDateSlug(entry.data.pubDate)}
                            </a>
                        </div>
                        <div>
                            <h2 class="font-heading text-xl font-semibold leading-7 text-foreground">
                                <a
                                    href={getThinkingHref(entry)}
                                    class="text-link"
                                >
                                    {entry.data.title}
                                </a>
                            </h2>
                            <p class="mt-1 text-sm leading-6 text-muted-foreground">
                                {entry.data.description}
                            </p>
                        </div>
                    </article>
                ))
            }
        </div>
    </section>
</Layout>
