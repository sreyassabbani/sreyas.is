---
import { getCollection } from "astro:content";
import {
    formatTag,
    getAllTags,
    getEntriesForTag,
    getTagHref,
    getThinkingTopics,
    groupEntriesByDate,
} from "@/lib/thinking";
import { SITE_TITLE } from "@/consts";
import { ThinkingTopicSelect } from "@/components/ThinkingTopicSelect";
import ThinkingEntryList from "@/components/ThinkingEntryList.astro";
import Layout from "@/layouts/Layout.astro";
import ThinkingClause from "@/layouts/components/ThinkingClause.astro";

export async function getStaticPaths() {
    const entries = await getCollection("posts");
    const tags = getAllTags(entries);
    return tags.map((tag) => ({
        params: { tag },
        props: {
            tag,
            entries: getEntriesForTag(entries, tag),
        },
    }));
}

const { tag, entries } = Astro.props;
const dateGroups = groupEntriesByDate(entries);
const topicOptions = getThinkingTopics(await getCollection("posts")).map(
    (topic) => ({
        href: getTagHref(topic.tag),
        label: formatTag(topic.tag),
        count: topic.entries.length,
    }),
);
---

<Layout
    title={`${SITE_TITLE} — Thinking about ${formatTag(tag)}`}
    description={`Posts and notes about ${formatTag(tag).toLowerCase()}.`}
>
    <ThinkingClause slot="clause" relation="about">
        <ThinkingTopicSelect
            pathname={Astro.url.pathname}
            topics={topicOptions}
            client:load
        />
    </ThinkingClause>

    <section class="mt-8 space-y-8">
        <h1 class="sr-only">Thinking about {formatTag(tag).toLowerCase()}</h1>
        <ThinkingEntryList groups={dateGroups} />
    </section>
</Layout>
