---
import { getCollection } from "astro:content";
import {
    formatTag,
    getAllTags,
    getEntriesForTag,
    groupEntriesByDate,
} from "@/lib/thinking";
import { SITE_TITLE } from "@/consts";
import ThinkingEntryList from "@/components/ThinkingEntryList.astro";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
    const entries = await getCollection("posts");
    const tags = getAllTags(entries);
    return tags.map((tag) => ({
        params: { tag },
        props: {
            tag,
            entries: getEntriesForTag(entries, tag),
        },
    }));
}

const { tag, entries } = Astro.props;
const dateGroups = groupEntriesByDate(entries);
---

<Layout
    title={`${SITE_TITLE} — Thinking about ${formatTag(tag)}`}
    description={`Posts and notes about ${formatTag(tag).toLowerCase()}.`}
>
    <section class="mt-8 space-y-8">
        <header class="space-y-4 border-b border-border pb-5">
            <a
                href="/thinking/about/"
                class="inline-flex text-sm text-muted-foreground no-underline transition-colors duration-200 hover:text-foreground"
            >
                Back to topics
            </a>
            <h1
                class="font-heading text-2xl font-semibold tracking-tight text-foreground"
            >
                {formatTag(tag).toLowerCase()}
            </h1>
        </header>
        <ThinkingEntryList groups={dateGroups} />
    </section>
</Layout>
