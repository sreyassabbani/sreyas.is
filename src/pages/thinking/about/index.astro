---
import { getCollection } from "astro:content";
import { SITE_TITLE } from "@/consts";
import ThinkingTopicGrid from "@/components/ThinkingTopicGrid.astro";
import { getThinkingTopics } from "@/lib/thinking";
import Layout from "@/layouts/Layout.astro";

const topics = getThinkingTopics(await getCollection("posts"));
---

<Layout
    title={`${SITE_TITLE} — Thinking by topic`}
    description="Thinking grouped by topic."
>
    <section class="mt-8">
        <ThinkingTopicGrid topics={topics} />
    </section>
</Layout>
