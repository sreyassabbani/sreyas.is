---
import { getCollection } from "astro:content";
import { SITE_TITLE } from "@/consts";
import {
    formatTag,
    getDateSlug,
    getTagHref,
    getThinkingHref,
    getThinkingTopics,
} from "@/lib/thinking";
import Layout from "@/layouts/Layout.astro";
import ThinkingRangeFilter from "@/components/ThinkingRangeFilter.astro";

const topics = getThinkingTopics(await getCollection("posts"));
---

<Layout
    title={`${SITE_TITLE} — Thinking by subject`}
    description="Thinking grouped by subject."
>
    <section class="mt-8 space-y-8 sm:space-y-9">
        <h1 class="sr-only">Thinking by subject</h1>
        <ThinkingRangeFilter />
        {
            topics.map((topic) => (
                <section
                    class="grid gap-3 sm:grid-cols-[8rem_1fr]"
                    aria-labelledby={`subject-${topic.tag}`}
                    data-thinking-subject
                >
                    <h2
                        id={`subject-${topic.tag}`}
                        class="translate-y-1 font-mono text-xs font-normal text-primary"
                    >
                        <a
                            href={getTagHref(topic.tag)}
                            data-thinking-subject-link={getTagHref(topic.tag)}
                        >
                            {formatTag(topic.tag).toLowerCase()}
                        </a>
                    </h2>
                    <ul class="m-0 list-none space-y-2 p-0">
                        {topic.entries.map((entry) => (
                            <li
                                class="font-heading text-md font-semibold text-foreground"
                                data-thinking-entry-date={getDateSlug(
                                    entry.data.pubDate,
                                )}
                            >
                                <a
                                    href={getThinkingHref(entry)}
                                    class="text-link"
                                >
                                    {entry.data.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            ))
        }
    </section>
</Layout>
