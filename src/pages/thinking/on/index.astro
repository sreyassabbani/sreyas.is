---
import { getCollection } from "astro:content";
import { formatThinkingDate, groupEntriesByDate } from "@/lib/thinking";
import { SITE_TITLE } from "@/consts";
import { ThinkingDateRangePicker } from "@/components/ThinkingDateRangePicker";
import Layout from "@/layouts/Layout.astro";
import ThinkingLens from "@/layouts/components/ThinkingLens.astro";

const dateGroups = groupEntriesByDate(await getCollection("posts"));
const dates = dateGroups.map((group) => ({
    dateSlug: group.dateSlug,
    label: formatThinkingDate(group.date),
    count: group.entries.length,
}));
---

<Layout
    title={`${SITE_TITLE} — Thinking by date`}
    description="Thinking grouped by date."
    variant="lens"
    showNavigation={false}
>
    <ThinkingLens pathname={Astro.url.pathname} relation="on">
        <ThinkingDateRangePicker dates={dates} client:only="react" />
    </ThinkingLens>
</Layout>
