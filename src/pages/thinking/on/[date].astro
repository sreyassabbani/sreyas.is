---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { formatThinkingDate, groupEntriesByDate } from "@/lib/thinking";
import { SITE_TITLE } from "@/consts";
import ThinkingEntryList from "@/components/ThinkingEntryList.astro";
import Layout from "@/layouts/Layout.astro";

type RenderedShortEntry = {
    entry: CollectionEntry<"posts">;
    Content: Awaited<ReturnType<typeof render>>["Content"];
};

export async function getStaticPaths() {
    const groups = groupEntriesByDate(await getCollection("posts"));
    return groups.map((group) => ({
        params: { date: group.dateSlug },
        props: group,
    }));
}

const { date, shortEntries } = Astro.props;
const dateGroups = [Astro.props];
const renderedShortEntries: RenderedShortEntry[] = await Promise.all(
    shortEntries.map(async (entry) => ({
        entry,
        Content: (await render(entry)).Content,
    })),
);
---

<Layout
    title={`${SITE_TITLE} — Thinking on ${formatThinkingDate(date)}`}
    description={`Thinking from ${formatThinkingDate(date)}.`}
>
    <section class="mt-8 space-y-8">
        <h1 class="sr-only">Thinking on {formatThinkingDate(date)}</h1>
        <ThinkingEntryList
            groups={dateGroups}
            renderedShortEntries={renderedShortEntries}
        />
    </section>
</Layout>
