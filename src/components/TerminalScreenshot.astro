---
import type { ImageMetadata } from "astro";
type Props = { alt: string; image: ImageMetadata; label: string };
const { alt, image, label } = Astro.props;
---

<figure
    class="terminal-screenshot terminal-media not-prose"
    style={`--terminal-width: ${image.width / 2}px;`}
>
    <div class="terminal-stage" tabindex="0" role="region" aria-label={label}>
        <a
            href={image.src}
            data-plain-link
            aria-label={`${label} — open the full-size capture`}
        >
            <img
                src={image.src}
                width={image.width}
                height={image.height}
                style={`width: ${image.width / 2}px;`}
                alt={alt}
                loading="lazy"
                decoding="async"
            />
        </a>
    </div>
</figure>

<style>
    .terminal-screenshot a {
        display: block;
        width: max-content;
    }
    .terminal-screenshot a:focus-visible {
        outline: 2px solid var(--ring);
        outline-offset: 3px;
    }
    .terminal-screenshot img {
        display: block;
        max-width: none;
        height: auto;
        margin: 0;
    }
</style>
