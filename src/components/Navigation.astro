---
import { homeNavigationItems, type NavigationItem } from "@/lib/navigation";
import ThemeToggle from "./ThemeToggle.astro";
import GitHub from "./social/GitHub.astro";
import LinkedIn from "./social/LinkedIn.astro";
import Email from "./social/Email.astro";
import { NavigationDropdown } from "./NavigationDropdown";
import { ThinkingFilterControl } from "./ThinkingFilterControl";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";

const navLinkClass =
    "group relative flex items-center justify-center pb-4 translate-y-4 md:translate-y-2 text-sm text-foreground no-underline transition-colors duration-200 hover:text-primary md:pb-2";
const navUnderlineClass =
    "absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 bg-primary transition-transform duration-300 group-hover:scale-x-100";
const mobileControlsClass = isHome
    ? "flex shrink-0 items-center gap-2 md:hidden"
    : "flex shrink-0 translate-x-6 items-center gap-2 md:hidden";
const desktopControlsClass = isHome
    ? "absolute -bottom-4 -right-4 z-10 hidden translate-x-4 items-center gap-2 md:flex"
    : "absolute -bottom-4 -right-8 z-10 items-center gap-2 md:flex";

const thinkingFilterControlClass = "translate-x-2";
const socialLinksClass =
    "flex items-center gap-1 translate-y-1 md:gap-4 md:px-3 md:py-2";

const primaryNavigationClass = isHome
    ? "flex items-center gap-4 md:gap-4 lg:gap-6"
    : "flex translate-y-4 items-center gap-3 pb-4 md:translate-y-2 md:gap-4 md:pb-2";
---

<nav
    class="relative flex w-full flex-col gap-3 border-b border-border py-3 text-sm text-foreground md:h-14 md:flex-row md:items-center md:justify-between md:gap-0 md:px-2 md:pb-8"
>
    <div
        class="flex items-center justify-between gap-3 md:w-1/3 md:min-w-0 md:justify-start"
    >
        <a
            href="/"
            class="flex min-w-0 flex-1 items-center no-underline hover:text-foreground md:flex-none"
        >
            <span
                class="block font-brand text-[clamp(1.8rem,8vw,2.35rem)] leading-none font-semibold tracking-tight"
            >
                <span>sreyas</span><span class="text-primary">.is</span>
            </span>
        </a>
        <div class={mobileControlsClass}>
            <ThemeToggle />
            <ThinkingFilterControl
                pathname={pathname}
                className={thinkingFilterControlClass}
                client:only="react"
            />
        </div>
    </div>

    <div
        class="flex items-center justify-between gap-4 md:w-2/3 md:min-w-0 md:justify-end md:gap-4 lg:gap-6"
    >
        <div class={primaryNavigationClass}>
            {
                isHome ? (
                    homeNavigationItems.map((item: NavigationItem) => (
                        <a href={item.href} class={navLinkClass}>
                            {item.label}
                            <span class={navUnderlineClass} />
                        </a>
                    ))
                ) : (
                    <NavigationDropdown
                        pathname={pathname}
                        client:only="react"
                    />
                )
            }
        </div>

        {
            isHome && (
                <div class={socialLinksClass}>
                    <GitHub />
                    <LinkedIn />
                    <Email />
                </div>
            )
        }
    </div>
    <div class={desktopControlsClass}>
        <ThemeToggle />
        <ThinkingFilterControl
            pathname={pathname}
            className={thinkingFilterControlClass}
            client:only="react"
        />
    </div>
</nav>
