---
type TranscriptLine =
    | {
          command: string;
          kind: "prompt";
          marker: string;
          user: string;
      }
    | {
          kind: "cwd" | "output" | "status";
          text: string;
      };

type Props = {
    className?: string;
    label: string;
    transcript: string;
};

const { className = "", label, transcript } = Astro.props;

const normalizedTranscript = transcript
    .replaceAll("\r\n", "\n")
    .replace(/^\n/, "")
    .replace(/\n$/, "");

const lines: TranscriptLine[] = normalizedTranscript.split("\n").map((text) => {
    const prompt = text.match(/^(\S+)\s+\[([^\]]+)](?:\s(.*))?$/);

    if (prompt) {
        return {
            kind: "prompt",
            user: prompt[1],
            marker: prompt[2],
            command: prompt[3] ?? "",
        };
    }

    if (/^(?:~\/|\/Users\/|\.{1,2}\/)/.test(text)) {
        return { kind: "cwd", text };
    }

    if (/^(?:direnv:|warning:|error:)/i.test(text)) {
        return { kind: "status", text };
    }

    return { kind: "output", text };
});
---

<figure class:list={["terminal-transcript not-prose", className]}>
    <pre
        class="terminal-transcript__screen"
        data-copy-label="Copy terminal transcript"
        data-copyable-code
        tabindex="0"
        aria-label={label}><code>{
                lines.map((line, index) => (
                    <>
                        {line.kind === "prompt" ? (
                            <span class="terminal-transcript__line terminal-transcript__line--prompt">{
                                [
                                    <span class="terminal-transcript__user">{line.user}</span>,
                                    " ",
                                    <span class="terminal-transcript__marker">[{line.marker}]</span>,
                                    line.command ? " " : "",
                                    <span class="terminal-transcript__command">{line.command}</span>,
                                ]
                            }</span>
                        ) : (
                            <span class:list={[
                                    "terminal-transcript__line",
                                    `terminal-transcript__line--${line.kind}`,
                                ]} set:text={line.text} />
                        )}
                        {index < lines.length - 1 && "\n"}
                    </>
                ))
            }</code></pre>
</figure>

<style>
    .terminal-transcript {
        margin-block: 1.5rem;
        max-width: 100%;
    }

    .terminal-transcript__screen {
        position: relative;
        max-width: 100%;
        margin: 0;
        overflow-x: auto;
        border: 1px solid
            color-mix(in oklab, var(--border) 84%, var(--foreground) 16%);
        border-radius: calc(var(--radius) - 2px);
        background: color-mix(
            in oklab,
            var(--secondary) 66%,
            var(--background)
        );
        padding: 1rem 1.1rem;
        color: color-mix(
            in oklab,
            var(--foreground) 88%,
            var(--muted-foreground)
        );
        font-family: var(--font-brand);
        font-size: 0.875rem;
        font-variant-ligatures: none;
        font-weight: 400;
        line-height: 1.55;
        tab-size: 4;
        white-space: pre;
        word-break: normal;
        overflow-wrap: normal;
        -webkit-overflow-scrolling: touch;
    }

    .terminal-transcript__screen:focus-visible {
        outline: 2px solid color-mix(in oklab, var(--ring) 58%, transparent);
        outline-offset: 3px;
    }

    .terminal-transcript__screen code {
        display: block;
        min-width: max-content;
        border: 0;
        background: transparent;
        padding: 0;
        color: inherit;
        font: inherit;
        white-space: inherit;
    }

    .terminal-transcript__line {
        color: inherit;
    }

    .terminal-transcript__line--cwd,
    .terminal-transcript__line--status,
    .terminal-transcript__user {
        color: var(--muted-foreground);
    }

    .terminal-transcript__marker {
        color: var(--primary);
    }

    .terminal-transcript__command {
        color: var(--foreground);
    }

    :global(.dark) .terminal-transcript__screen {
        border-color: color-mix(
            in oklab,
            var(--border) 78%,
            var(--foreground) 22%
        );
        background: color-mix(
            in oklab,
            var(--secondary) 72%,
            var(--background)
        );
    }

    @media (min-width: 40rem) {
        .terminal-transcript__screen {
            padding: 1.1rem 1.25rem;
            font-size: 0.9375rem;
        }
    }
</style>
