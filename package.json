{
    "name": "sreyas.is",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "content:sync": "bun --bun ./scripts/mount-content.ts",
        "content:watch": "bun --bun ./scripts/watch-content.ts",
        "dev": "bun --bun ./scripts/dev.ts",
        "build": "bun --bun ./node_modules/.bin/astro build",
        "preview": "bun --bun ./node_modules/.bin/astro preview",
        "astro": "bun --bun ./node_modules/.bin/astro",
        "typecheck": "bun --bun ./node_modules/.bin/astro check",
        "fmt": "bun run fmt:biome && bun run fmt:astro",
        "fmt:astro": "bun --bun ./node_modules/.bin/prettier --write \"**/*.astro\"",
        "fmt:biome": "bun --bun ./node_modules/.bin/biome format --write .",
        "fmt:check": "bun run fmt:biome:check && bun run fmt:astro:check",
        "fmt:astro:check": "bun --bun ./node_modules/.bin/prettier --check \"**/*.astro\"",
        "fmt:biome:check": "bun --bun ./node_modules/.bin/biome format .",
        "lint": "bun --bun ./node_modules/.bin/biome lint .",
        "lint:fix": "bun --bun ./node_modules/.bin/biome lint --write .",
        "check": "bun --bun ./node_modules/.bin/biome check . && bun run fmt:astro:check",
        "check:fix": "bun --bun ./node_modules/.bin/biome check --write . && bun run fmt:astro",
        "ci": "bun run check && bun run typecheck && bun run build"
    },
    "dependencies": {
        "@astrojs/mdx": "^4.3.12",
        "@astrojs/react": "^4.4.2",
        "@astrojs/rss": "^4.0.14",
        "@astrojs/sitemap": "^3.6.0",
        "@base-ui/react": "^1.4.1",
        "@fontsource/dela-gothic-one": "^5.2.7",
        "@fontsource/eb-garamond": "^5.2.7",
        "@fontsource/geist-mono": "^5.2.8",
        "@fontsource/inter": "^5.2.8",
        "@fontsource/iosevka": "^5.2.5",
        "@fontsource/literata": "^5.2.8",
        "@fontsource/spectral": "^5.2.8",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "4.2.2",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "astro": "^5.16.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "katex": "^0.16.11",
        "lucide-react": "^1.7.0",
        "manim-web": "^0.3.21",
        "next-themes": "^0.4.6",
        "react": "^19.2.1",
        "react-day-picker": "^9.14.0",
        "react-dom": "^19.2.1",
        "react-resizable-panels": "^4.10.0",
        "recharts": "3.8.0",
        "rehype-katex": "^7.0.0",
        "remark-math": "^6.0.0",
        "sharp": "^0.34.5",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "4.2.2",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.8",
        "@astrojs/language-server": "^2.16.6",
        "@astrojs/ts-plugin": "^1.10.7",
        "@biomejs/biome": "^2.3.11",
        "@shikijs/transformers": "^3",
        "@types/bun": "^1.3.14",
        "@types/node": "^25.5.0",
        "prettier": "^3.8.1",
        "prettier-plugin-astro": "^0.14.1",
        "typescript": "5.9.3",
        "typescript-language-server": "^5.1.3"
    }
}
